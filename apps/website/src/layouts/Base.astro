---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Open spatial acoustic intelligence infrastructure" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111318" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Resonance</title>
  </head>
  <body class="bg-graphite text-white font-sans antialiased">
    <nav class="fixed top-0 w-full z-50 border-b border-white/5 bg-graphite/80 backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan to-violet flex items-center justify-center">
            <span class="text-sm font-bold text-graphite">R</span>
          </div>
          <span class="font-semibold text-lg">Resonance</span>
        </a>
        <div class="hidden md:flex items-center gap-8 text-sm text-white/70">
          <a href="/platform" class="hover:text-white transition-colors">Platform</a>
          <a href="/vectornode" class="hover:text-white transition-colors">VectorNode</a>
          <a href="/developers" class="hover:text-white transition-colors">Developers</a>
          <a href="https://github.com/resonance-project/resonance" class="px-4 py-2 rounded-lg bg-white/10 hover:bg-white/15 transition-colors text-white">GitHub</a>
        </div>
      </div>
    </nav>
    <main class="pt-16">
      <slot />
    </main>
    <footer class="border-t border-white/5 mt-32">
      <div class="max-w-7xl mx-auto px-6 py-16 grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
        <div>
          <h4 class="font-semibold mb-4 text-white">Platform</h4>
          <ul class="space-y-2 text-white/50">
            <li><a href="/platform" class="hover:text-white/80">Overview</a></li>
            <li><a href="/vectornode" class="hover:text-white/80">VectorNode X1</a></li>
            <li><a href="/developers" class="hover:text-white/80">Developers</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-4 text-white">Products</h4>
          <ul class="space-y-2 text-white/50">
            <li>Resonance Detect</li>
            <li>Resonance Mesh</li>
            <li>Resonance Field</li>
            <li>Resonance Fleet</li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-4 text-white">Resources</h4>
          <ul class="space-y-2 text-white/50">
            <li><a href="/developers" class="hover:text-white/80">Documentation</a></li>
            <li><a href="https://github.com/resonance-project/resonance" class="hover:text-white/80">GitHub</a></li>
            <li>API Reference</li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-4 text-white">Open Source</h4>
          <ul class="space-y-2 text-white/50">
            <li>Apache-2.0 License</li>
            <li>Contributing Guide</li>
            <li>Code of Conduct</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/5 py-8 text-center text-xs text-white/30">
        <p>Resonance Project — Open Spatial Acoustic Intelligence</p>
      </div>
    </footer>
  </body>
</html>
